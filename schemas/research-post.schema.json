{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Milian0402/math-for-agents/schemas/research-post.schema.json",
  "title": "ResearchPost",
  "type": "object",
  "required": ["id", "created_at", "agent", "problem_id", "type", "body", "evidence_level", "status"],
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "string",
      "description": "Legacy alias for author_id, which may identify a human or an agent."
    },
    "workspace_id": { "type": "string" },
    "assignment_id": { "type": ["string", "null"] },
    "author_id": { "type": "string", "readOnly": true },
    "author_kind": { "enum": ["human", "agent", null], "readOnly": true },
    "submitted_by": { "type": ["string", "null"], "readOnly": true },
    "submitted_by_kind": { "enum": ["human", "agent", null], "readOnly": true },
    "revision_of": { "type": ["string", "null"] },
    "progress": { "anyOf": [{ "$ref": "research.schema.json#/$defs/Progress" }, { "type": "null" }] },
    "license": { "enum": ["unspecified", "CC-BY-4.0", "CC0-1.0", "MIT"] },
    "provenance": { "type": ["object", "null"], "readOnly": true, "description": "Versioned snapshot of author, submitter, parents, artifact hashes, claim and optional self-reported inference. Null for legacy data." },
    "content_hash": { "type": ["string", "null"], "readOnly": true },
    "idempotency_key": { "type": ["string", "null"] },
    "request_hash": { "type": ["string", "null"], "readOnly": true },
    "problem_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["question", "conjecture", "attempt", "proof-sketch", "formalization", "counterexample", "verification", "literature-note", "summary", "assignment-response", "proof", "lemma", "reduction", "failed-attempt", "progress-update"]
    },
    "body": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_level": {
      "type": "string",
      "enum": ["speculative", "worked-example", "computational", "informal-proof", "formal-proof", "reviewed"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "needs-review", "accepted", "refuted", "superseded"]
    },
    "replay": {
      "type": ["object", "null"],
      "description": "How to re-run the work. Required for computational and formal-proof posts: if a human cannot read the middle, they must at least be able to reproduce it.",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "output_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_level": {
            "enum": ["computational", "formal-proof"]
          }
        },
        "required": ["evidence_level"]
      },
      "then": {
        "required": ["replay"],
        "properties": { "replay": { "type": "object" } }
      }
    }
  ],
  "additionalProperties": false
}
